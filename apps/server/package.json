{
  "name": "@assistant/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "device:pair": "tsx src/cli/pair.ts",
    "device:revoke": "tsx src/cli/revoke.ts",
    "diagnostics:relay": "tsx src/cli/diagnostics-relay.ts",
    "diagnostics:mcp": "tsx src/cli/diagnostics-mcp.ts",
    "backup": "tsx src/cli/backup.ts"
  },
  "dependencies": {
    "@assistant/agent-runtime": "workspace:*",
    "@assistant/contracts": "workspace:*",
    "@assistant/mcp-bridge": "workspace:*",
    "@assistant/train-domain": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ws": "8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
