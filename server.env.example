# Personal Assistant v0.1 — application configuration proposal.
# These are APP configuration names to implement, not Pi's native env contract.
# Copy outside version control. Do not commit real secrets.
# All URLs/model IDs below are placeholders. Replace before a live test.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
ASSISTANT_PUBLIC_URL=https://assistant.example.com
DATA_DIR=/app/data
DATABASE_PATH=/app/data/assistant.sqlite
LOG_LEVEL=info

# Exact origins must be measured on the locked Tauri Android build.
# Do not deploy wildcard CORS. Do not put credentials in query strings.
CORS_ALLOWED_ORIGINS=

# Relay bootstrap: imported only when no persisted profile exists.
# Real protocol must be verified; no protocol inference from model names.
RELAY_BASE_URL=https://relay.example.com/v1
RELAY_API=openai-completions
RELAY_MODEL_ID=REPLACE_WITH_ACTUAL_MODEL_ID
RELAY_ALLOWED_HOSTS=relay.example.com
RELAY_API_KEY_FILE=/run/secrets/relay_api_key
APP_MASTER_KEY_FILE=/run/secrets/app_master_key
APP_MASTER_KEY_VERSION=1

# 对话/意图解析链路：关闭后回退为本地规则解析与固定文案
AGENT_LLM_ENABLED=true
RELAY_TIMEOUT_MS=30000

# Fixed build artifact, never an arbitrary command from a mobile client.
MCP_COMMAND=node
MCP_ENTRYPOINT=/opt/12306-mcp/build/index.js
MCP_SOURCE_COMMIT=ff6439da6f63d7d72181abea4568abd69878c600
MCP_TRANSPORT=stdio
MCP_INIT_TIMEOUT_MS=30000
MCP_CALL_TIMEOUT_MS=20000
MCP_MAX_CONCURRENCY=1
MCP_MIN_INTERVAL_MS=1000
MCP_READ_RETRIES=1
MCP_MAX_RESULT_BYTES=2097152

# Run policy — design defaults, not upstream quotas.
RUN_TIMEOUT_MS=120000
RUN_MAX_ACTIVE_GLOBAL=2
RUN_MAX_ACTIVE_PER_CONVERSATION=1
RUN_MAX_AGENT_TOOL_CALLS=8
TRAIN_MAX_STATION_PAIRS=12
TRAIN_CACHE_TTL_SECONDS=30
MODEL_SUMMARY_MAX_TICKETS=20
MESSAGE_MAX_CHARS=8000

# Model token/context limits must be configured against the actual relay.
# Missing pricing/usage means unknown, not zero cost.
MODEL_MAX_OUTPUT_TOKENS=
MODEL_CONTEXT_WINDOW=

# Application SSE policy.
SSE_HEARTBEAT_SECONDS=15
SSE_DELTA_FLUSH_MS=100
EVENT_RETENTION_DAYS=7
DIAGNOSTIC_LOG_RETENTION_DAYS=30

# Device pairing/token policy.
PAIRING_TTL_SECONDS=600
DEVICE_TOKEN_TTL_DAYS=90

# Safety: must remain disabled in release.
ALLOW_FIXTURES=false
ALLOW_UNTRUSTED_EXTENSIONS=false
ALLOW_GENERIC_SHELL_TOOLS=false
ALLOW_PRIVATE_RELAY_TARGETS=false
TELEMETRY_ENABLED=false
